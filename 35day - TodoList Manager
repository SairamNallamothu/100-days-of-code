def color(color,text):
  if(color == "red"):
    return "\033[91m" + text + "\033[0m"
  elif (color == "green"):
    return "\033[92m" + text + "\033[0m"
  elif (color == "yellow"):
    return "\033[93m" + text + "\033[0m"
  elif (color == "blue"):
    return "\033[94m" + text + "\033[0m"
  elif (color == "purple"):
    return "\033[95m" + text + "\033[0m"
  elif (color == "cyan"):
    return "\033[96m" + text + "\033[0m"
  elif (color == "white"):
    return "\033[97m" + text + "\033[0m"
  elif (color == "black"):
    return "\033[98m" + text + "\033[0m"
  else:
    return text

TodoList = []

def printList():
  for item in TodoList:
    print(f"{color('yellow',item)}")  

print(f"{color('red','To Do List Manager:'):^70}")
print()

while True:
  print()
  option = input("Select an option: add, edit, view, remove and exit?")
  if(option == "add"):
   item = input("Enter a to-do item: ")
   if item in TodoList:
    print(f"{color('red','Item already exists!')}")
    print()
   else:
    TodoList.append(item)
    print(f"{color('green','Item added!')}")
    print()
  elif (option == "remove"):
    print()
    printList()
    print()
    item = input("Do you want to remove an item or all items? (item/all) ")
    if item == "all":
      TodoList.clear()
      print(f"{color('green','All items removed!')}")
      print()
      continue
    else:
      item = input("Enter the item to remove: ")
      if item in TodoList:
       TodoList.remove(item)
       print(f"{color('green','Item removed!')}")
       print()
       printList()
       print()
       print(f"{color('green','End of list.')}")
      else:
       print(f"{color('red','Item not found!')}")
       print()
  elif (option == "view"):
    print()
    print(f"{color('green','Your to-do list:')}") 
    printList()
    print()
    print(f"{color('green','End of list.')}")
    print()
  elif (option == "exit"):
    print(f"{color('green','Goodbye!')}")
    break
  elif (option == "edit"):
    print()
    printList()
    print()
    item = input("Enter the item to edit: ")
    if item in TodoList:
      new_item = input("Enter the new item: ")
      TodoList[TodoList.index(item)] = new_item
      print(f"{color('green','Item edited!')}")
      print()
      printList()
      print()
      print(f"{color('green','End of list.')}")
      print()
    else:
      print(f"{color('red','Item not found!')}")
      print()
      printList()
      print(f"{color('green','End of list.')}")
      print()
  else:
    print(f"{color('red','Invalid option!')}")


