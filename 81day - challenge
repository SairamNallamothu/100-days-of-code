from flask import Flask, request

app = Flask(__name__)


@app.route("/robotcheck", methods=["POST"])
def robotcheck():
  page = ""
  form = request.form
  
  if (
    form.get("metalno") == "no"
    and form.get("infinity") == "infinity"
    and form.get("food") == "Human Food"
  ):
    return "You are a Human"
  else:
    return "You are a Robot"



@app.route('/')
def index():
  f = open("templates/index.html", "r")
  file = f.read()
  f.close()
  return file


app.run(host='0.0.0.0', port=81)

