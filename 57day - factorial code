def factorial(value):
  a = value
  fact = 1
  if value == 0 or value == 1:
    print("The factorial of", value, "is", 1)
    return
  else:
    for i in range(1, value):
      fact = fact * a
      a = a - 1
    print()
    print("The factorial of", value, "is", fact)


while True:
  print("-------------------------")
  print("🌟Factorial Finder🌟\n")
  print()
  value = input("Enter a number to find its factorial >")
  factorial(int(value))
  print()
  exit = input("Press enter to continue or type exit to quit >")
