import tkinter as tk
from functools import partial
import os

window = tk.Tk()
window.title("Calculator") 
window.geometry("300x300") 

label = " "

def buttonChoice(value):
    global label
    label+=str(value)
    hello.config(text=label)

def operatorChoice(value):
    global label
    label+=str(value)
    hello.config(text=label)

def equalChoice():
    global label
    hello.config(text = eval(label))
    label = str(eval(label))

def clear():
  global label
  label = " "
  hello.config(text = label)

hello = tk.Label(text = label)
hello.grid(row=0, column=0, columnspan=3)

button = tk.Button(text = "1",command=partial(buttonChoice, 1)).grid(row=1, column=1)
button = tk.Button(text = "2",command=partial(buttonChoice, 2)).grid(row=1, column=2)
button = tk.Button(text = "3",command=partial(buttonChoice, 3)).grid(row=1, column=3)
button = tk.Button(text = "+",command=partial(buttonChoice, "+")).grid(row=1, column=4)
button = tk.Button(text = "-",command=partial(buttonChoice, "-")).grid(row=1, column=5)

button = tk.Button(text = "4",command=partial(buttonChoice, 4)).grid(row=2, column=1)
button = tk.Button(text = "5",command=partial(buttonChoice, 5)).grid(row=2, column=2)
button = tk.Button(text = "6",command=partial(buttonChoice, 6)).grid(row=2, column=3)
button = tk.Button(text = "*",command=partial(buttonChoice, "*")).grid(row=2, column=4)
button = tk.Button(text = "/",command=partial(buttonChoice, "/")).grid(row=2, column=5)

button = tk.Button(text = "7",command=partial(buttonChoice, 7)).grid(row=3, column=1)
button = tk.Button(text = "8",command=partial(buttonChoice, 8)).grid(row=3, column=2)
button = tk.Button(text = "9",command=partial(buttonChoice, 9)).grid(row=3, column=3)

button = tk.Button(text = "0",command=partial(buttonChoice, 0)).grid(row=4, column=2)
button = tk.Button(text = "=",command=partial(equalChoice)).grid(row=4, column=4)
button = tk.Button(text = "cls",command=partial(clear)).grid(row=4, column=5)

tk.mainloop()
