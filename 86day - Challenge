from flask import Flask, redirect, request, session
from replit import db
import os

app = Flask(__name__)
userName = "sairam"
userPassword = "sairam"

app.secret_key = os.environ['sessionKey']
blogList = {"Title": " ", "date":" ", "Body_Text":" "}

blogs = db["Blogs"]

@app.route('/')
def index():
  f = open("login.html", "r")
  page = f.read()
  f.close()
  length = len(db["Blogs"])
  for i in range(length - 1, -1, -1):
    page += "<hr>"
    page += "<h2>" + db["Blogs"][i]["Title"] + "</h2>"
    page += "<h3>" + db["Blogs"][i]["date"] + "</h3>"
    page += "<p>" + db["Blogs"][i]["Body_Text"] + "</p>"
  return page

@app.route('/login', methods=['POST', 'GET'])
def login():
  if request.form['username'] == userName and request.form['password'] == userPassword:
    session["username"] = request.form["username"]
    f = open("blogAdd.html", "r")
    page = f.read()
    f.close()
    length = len(db["Blogs"])
    for i in range(length - 1, -1, -1):
      page += "<hr>"
      page += "<h2>" + db["Blogs"][i]["Title"] + "</h2>"
      page += "<h3>" + db["Blogs"][i]["date"] + "</h3>"
      page += "<p>" + db["Blogs"][i]["Body_Text"] + "</p>"
    return page
  else:
    return redirect("/")

@app.route('/logout', methods=['POST', 'GET'])
def logout():
  if session["username"] == userName:
    session.clear()
    return redirect("/")
  else:
    return redirect("/")

@app.route('/blogAdd', methods=['POST', 'GET'])
def blogAdd():
  if request.form['title'] or request.form['date'] or request.form['body_text']:
    blogList["Title"] = request.form['title']
    blogList["date"] = request.form['date']
    blogList["Body_Text"] = request.form['body_text']
    db["Blogs"].append(blogList)
    f = open("blogAdd.html", "r")
    page = f.read()
    f.close()
    length = len(db["Blogs"])
    for i in range(length - 1, -1, -1):
      page += "<hr>"
      page += "<h2>" + db["Blogs"][i]["Title"] + "</h2>"
      page += "<h3>" + db["Blogs"][i]["date"] + "</h3>"
      page += "<p>" + db["Blogs"][i]["Body_Text"] + "</p>"
    return page
  else:
    return redirect("/login")

app.run(host='0.0.0.0', port=81)
