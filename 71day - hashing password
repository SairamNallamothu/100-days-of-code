from replit import db
import os, time

while True:
  print("🌟Login System🌟")
  print()
  userMenu = input("Do you want to add a user, login or exit? (a/l/e) >")
  print()
  if userMenu == "a":
    username = input("Username >")
    print()
    password = input("Password >")
    print()
    salt = 14221
    newPassword = f"{password}{salt}" # append the salt
    newPassword = hash(newPassword) # hash the lot
    #print(newPassword)
  
    db[username] = {"password":newPassword, "salt": salt}
    print("User added")
    time.sleep(3)
    os.system("clear")
  elif userMenu == "l":
    username = input("Username >")
    print()
    password  = input("Password >")
    print()
    salt = db[username]["salt"] 
    newPassword = f"{username}{salt}"
    newPassword = hash(newPassword) 
    #print(newPassword)
    if newPassword == db[username]["password"]: 
      print("Login successful")
      print()
      time.sleep(3)
      os.system("clear")
      print()
    else:
      print("Login failed")
      print()
      time.sleep(3)
      os.system("clear")
  elif userMenu == "e":
    print()
    print("Goodbye")
    break
  else:
    print("Invalid option")
    print()
    continue
