from flask import Flask

app = Flask(__name__)

@app.route('/<pageNumber>')

def page(pageNumber):
  f = open('templates/day.html', 'r')
  html = f.read()
  f.close()
  html = html.replace('{number}', pageNumber)
  return html

@app.route('/')
def index():
  return "This is the home page. Enter a page number in the URL."

app.run(host='0.0.0.0', port=81)



