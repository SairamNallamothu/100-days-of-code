import os, shutil, datetime

print("🌟Life Organizer🌟")
print()
todos = []
temp = []

f = open("todos.txt","r")
todos = eval(f.read())
f.close()

questions = ["What is the task? >", "When is it due by? >", "What is the priority? >"]

def pettyPrint():
  length = len(todos)
  for i in range(length):
    print(i+1,":",todos[i])
    print()
    print("--------------------------------------------------")
    print()

def viewPriority(viewPrio):
  length = len(todos)
  for i in range(length):
    if todos[i][2] == viewPrio:
      print(todos[i])
      print()
      print("--------------------------------------------------")

def editTodo(editInput):
  print(todos[editInput-1])
  print()
  Edit = input("What do you want to edit: Task, Due by or priority?").lower().strip()
  if Edit == "task":
    print()
    userInput = input("Enter the new task >")
    todos[editInput-1][0] = userInput
  elif Edit == "due by":
    print()
    userInput = input("Enter the new due date >")
    todos[editInput-1][1] = userInput
  elif Edit == "priority":
    print()
    userInput = input("Enter the new priority >")
    todos[editInput-1][2] = userInput
  else:
    print("Please enter a valid command.")


while True:
  print()
  userInput = input("Welcome to Life Organizer. Do you want to add, view, edit, remove a todo or exit? >")

  if userInput.lower().strip() == "add" or userInput.lower().strip() == "edit" or userInput.lower().strip() == "remove" or userInput.lower().strip() == "view":

    if userInput.lower().strip() == "add":
      for question in questions:
        print()
        userInput = input(question)
        temp.append(userInput)
      todos.append(temp)
      temp = []
    elif userInput.lower().strip() == "view":
      print()
      viewType = input("Do you want to view all or view specifc priority? >")
      if viewType.lower().strip() == "all":
        pettyPrint()
      else:
        print()
        viewPrio = input("Enter the priority of todo's you want to see >")
        viewPriority(viewPrio)
      continue
    elif userInput.lower().strip() == "edit":
      print()
      pettyPrint()
      editInput = int(input("Enter the task number you want to edit >"))
      editTodo(editInput)
      print()
      print("Your updated todo is: ")
      print(todos[editInput-1])
      print()
      print("--------------------------------------------------")
      print()
    elif userInput.lower().strip() == "remove":
      pettyPrint()
      removeInput = int(input("Enter the task number you want to remove >"))
      todos.pop(removeInput-1)
      print()
      print("Your updated todo list is: ")
      pettyPrint()
      print()
      print("--------------------------------------------------")
  elif userInput.lower().strip() == "exit" :
    os.makedirs("Backup", exist_ok=True)
    filename = "Backup/"+ datetime.datetime.now().strftime("%Y-%m-%d-%H-%M-%S") + "_todos.txt"
    shutil.copy("todos.txt", filename)
    break
  else:
    print("Please enter a valid command.")
    continue

  print()
  os.makedirs("Backup", exist_ok=True)
  filename = "Backup/"+ datetime.datetime.now().strftime("%Y-%m-%d-%H-%M-%S") + "_todos.txt"
  shutil.copy("todos.txt", filename)
  
  f = open("todos.txt", "w") 
  f.write(str(todos)) 
  f.close()
