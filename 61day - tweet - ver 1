from replit import db
import datetime

def clear():
  keys = db.keys()
  for key in keys:
    del db[key]
  #print("Database cleared!")
  print()
#clear()
print()
print("Welcome to Twitter!")

while True:
  print()
  userSelection = input("What would you like to do? (add or view tweets or exit): ")
  print()
  if userSelection == "add":
    tweet = input("What would you like to tweet? ")
    print()
    tweet_time = datetime.datetime.now()
    tweet_time = tweet_time.strftime("%Y-%m-%d %H:%M:%S")
    db[tweet_time] = tweet
    print("Tweet added!")
    print()
  elif userSelection == "view":
    print("Tweets: ")
    print()
    keys = db.keys()
    count = 0
    length = len(keys)
    print(f"Total tweets: {length}")
    print()
    for key in keys:
      print(f"{key}: {db[key]}")
      count += 1
      if count == 10:
       print()
       userSelection = input("Would you like to view 10 more tweets? (yes or no): ")
       if userSelection == "yes":
        count = 0
        print()
        continue
       else:
         print("Returning to main menu.")
         print()
         break
    print()
    print("No more Tweets to view. Returning to main menu.")
        
  elif userSelection.lower() == "exit":
    print()
    print("Goodbye!")
    break
  else:
    print("Invalid selection. Please try again.")
    print()
    continue
    
